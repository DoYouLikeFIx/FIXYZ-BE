# Reviewer-facing backend local profile template.
# This file is documentation, not a Spring Boot runtime input.
# Actual runtime profiles remain service-local:
# - channel-service/src/main/resources/application-local.yml
# - corebank-service/src/main/resources/application-local.yml
# - fep-gateway/src/main/resources/application-local.yml
# - fep-simulator/src/main/resources/application-local.yml

template:
  purpose: "Summarize the shared local-profile contract used by the backend services."
  runtimeReferences:
    - "channel-service/src/main/resources/application-local.yml"
    - "corebank-service/src/main/resources/application-local.yml"
    - "fep-gateway/src/main/resources/application-local.yml"
    - "fep-simulator/src/main/resources/application-local.yml"
  sharedEnvironmentReference: "../.env.example"

sharedDefaults:
  mysql:
    username: "${MYSQL_USER:fix}"
    password: "${MYSQL_PASSWORD:fix}"
    host: "mysql"
    port: 3306
  redis:
    host: "${REDIS_HOST:redis}"
    port: "${REDIS_PORT:6379}"
  vault:
    addr: "${VAULT_ADDR:http://vault:8200}"
    token: "${VAULT_TOKEN:root-token}"

services:
  channel-service:
    datasource:
      url: "${CHANNEL_DB_URL:jdbc:mysql://mysql:3306/channel_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true}"
      username: "${CHANNEL_DB_USERNAME:${MYSQL_USER:fix}}"
      password: "${CHANNEL_DB_PASSWORD:${MYSQL_PASSWORD:fix}}"
    redis:
      host: "${REDIS_HOST:redis}"
      port: "${REDIS_PORT:6379}"
    auth:
      totpVaultBaseUrl: "${AUTH_TOTP_VAULT_BASE_URL:${VAULT_ADDR:http://vault:8200}}"
      totpVaultToken: "${AUTH_TOTP_VAULT_TOKEN:${VAULT_TOKEN:root-token}}"
      trustStorePath: "${AUTH_TOTP_VAULT_TRUST_STORE_PATH:}"
      trustStorePassword: "${AUTH_TOTP_VAULT_TRUST_STORE_PASSWORD:}"
      trustStoreType: "${AUTH_TOTP_VAULT_TRUST_STORE_TYPE:PKCS12}"
    internal:
      corebankBaseUrl: "${COREBANK_INTERNAL_BASE_URL:http://corebank-service:8081}"
    server:
      sessionCookieSecure: false

  corebank-service:
    datasource:
      url: "${CORE_DB_URL:jdbc:mysql://mysql:3306/core_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true}"
      username: "${CORE_DB_USERNAME:${MYSQL_USER:fix}}"
      password: "${CORE_DB_PASSWORD:${MYSQL_PASSWORD:fix}}"
    fep:
      gatewayBaseUrl: "${FEP_GATEWAY_BASE_URL:http://fep-gateway:8083}"
    provisioning:
      defaultCashBalance: "${COREBANK_PROVISIONING_DEFAULT_CASH_BALANCE:100000000.0000}"

  fep-gateway:
    datasource:
      url: "${FEP_GATEWAY_DB_URL:jdbc:mysql://mysql:3306/fep_gateway_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true}"
      username: "${FEP_GATEWAY_DB_USERNAME:${MYSQL_USER:fix}}"
      password: "${FEP_GATEWAY_DB_PASSWORD:${MYSQL_PASSWORD:fix}}"
    simulator:
      controlPlaneBaseUrl: "${FEP_SIMULATOR_CONTROL_PLANE_BASE_URL:http://localhost:8082}"

  fep-simulator:
    datasource:
      url: "${FEP_SIMULATOR_DB_URL:jdbc:mysql://mysql:3306/fep_simulator_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true}"
      username: "${FEP_SIMULATOR_DB_USERNAME:${MYSQL_USER:fix}}"
      password: "${FEP_SIMULATOR_DB_PASSWORD:${MYSQL_PASSWORD:fix}}"
